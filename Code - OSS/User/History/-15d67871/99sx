{
    "layer": "top",
    "position": "top",
    "height": 42,
    "margin-top": 2,
    "margin-left": 3,
    "margin-right": 3,
    "spacing": 10,

    // =========================
    // MODULES
    // =========================

    "modules-left": [
        "group/left"
    ],

    "modules-center": [
        "group/center"
    ],

    "modules-right": [
        "group/right"
    ],

    // =========================
    // GROUP CAPSULES
    // =========================

    "group/left": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300
        },
        "modules": [
            "hyprland/workspaces"
            // "custom/media"
        ]
    },

    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "custom/window"
        ]
    },

    "group/right": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 1000
        },
        "modules": [
            "clock",
            "network",
            "pulseaudio",
            "backlight",
            "battery",
            "custom/power"
        ]
    },

    // =========================
    // WORKSPACES
    // =========================

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "persistent-workspaces": {
            "*": [1]
        },
        "format": "❄️"
    },

    // =========================
    // WINDOW TITLE
    // =========================
    //    "hyprland/window": {
    //        "format": "{}",
    //        "max-length": 40,
    //        "separate-outputs": true,
    //        "rewrite": {
    //            "^\\s*$": "Welcome back master!!"
    //        }
    //    },
    "custom/window": {
        "exec": "~/.config/waybar/scripts/window.py",
        "return-type": "json",
            "rewrite": {
                "^\\s*$": "Welcome back master!!"
        }
    },

    // =========================
    // CLOCK
    // =========================

    "clock": {
        "format": " {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // =========================
    // NETWORK
    // =========================

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭 off"
    },

    // =========================
    // AUDIO
    // =========================

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },

    // =========================
    // BRIGHTNESS
    // =========================

    "backlight": {
        "format": "󰃟 {percent}%"
    },

    // =========================
    // BATTERY
    // =========================

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    // =========================
    // POWER
    // =========================

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout -b 6 --protocol layer-shell"
    }
}
